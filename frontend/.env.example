# StratoEscrow Frontend Environment Variables

# Soroban Contract Address (replace with deployed contract address)
NEXT_PUBLIC_CONTRACT_ADDRESS=YOUR_CONTRACT_ADDRESS_HERE

# Stellar Network Passphrase
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# For mainnet, use:
# NEXT_PUBLIC_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# Stellar RPC URL (optional for Horizon integration)
NEXT_PUBLIC_STELLAR_RPC_URL=https://horizon-testnet.stellar.org
